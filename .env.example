# ============================================
# Weather API - variables de entorno
# Copia este archivo a .env y ajusta los valores:
#   cp .env.example .env
# ============================================

# --- Aplicación ---
# Puerto en el que escucha la API (puerto del host en Docker Compose)
PORT=3000

# Clave API de Visual Crossing (obligatoria).
# Obtén una en https://www.visualcrossing.com/weather-api
VISUAL_CROSSING_API_KEY=

# TTL de la caché en Redis, en segundos (12 h por defecto)
CACHE_TTL_SECONDS=43200

# --- Redis ---
# REDIS_HOST se sobreescribe a "redis" dentro de Compose; aquí se usa
# si ejecutas la app fuera de Docker.
REDIS_HOST=localhost
REDIS_PORT=6379
# Contraseña de Redis (vacía si no requiere autenticación)
REDIS_PASSWORD=